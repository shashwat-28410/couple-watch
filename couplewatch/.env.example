VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- WEBRTC TURN RELAY (For strict Wi-Fi, Campus, or CGNAT firewalls) ---
# Option 1: Cloudflare Calls TURN (Recommended: 1,000 GB / 1 TB Free per month - https://dash.cloudflare.com)
VITE_CLOUDFLARE_TURN_KEY_ID=
VITE_CLOUDFLARE_TURN_TOKEN=

# Option 2: Custom / Self-Hosted coTURN / Twilio Static Credentials
# VITE_TURN_URL=turns:your-turn-server.com:443?transport=tcp
# VITE_TURN_USERNAME=your-username
# VITE_TURN_CREDENTIAL=your-password

# Option 3: Metered Video (500MB free per month - https://dashboard.metered.ca/)
# VITE_METERED_APP_NAME=
# VITE_METERED_API_KEY=
